; PaperVerse: 3D Origami Studio (F7 Developer)

config_version=5

[application]

config/name="PaperVerse"
config/description="Draw crease patterns, fold them in real time, animate and export. An origami studio by F7 Developer."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.952941, 0.945098, 0.92549, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/splash/emblem.png"
boot_splash/stretch_mode=0
boot_splash/use_filter=true
config/icon="res://icon.png"

[autoload]

Studio="*res://scripts/studio_app.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.952941, 0.945098, 0.92549, 1)
